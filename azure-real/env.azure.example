# Runtime env vars for Azure Container Apps (Azure native mode)
NODE_ENV=production
PORT=8080

# Azure native storage/database modes
STORAGE_MODE=azure
DB_MODE=cosmos

# Azure Blob
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_RAW=raw
AZURE_STORAGE_CONTAINER_EXPORTS=exports

# Azure Cosmos DB
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=facturasdb
AZURE_COSMOS_CONTAINER=documents

# Intake security
WORKATO_SHARED_SECRET=pon_aqui_un_secreto_largo
ENABLE_WORKATO_REMOTE_URLS=false
COES_VALIDATION_AUTO_SYNC=true
