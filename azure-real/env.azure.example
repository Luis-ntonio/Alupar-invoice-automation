# Runtime env vars for Azure Container Apps (current codebase without Azure SDK migration)
NODE_ENV=production
PORT=8080

# Keep local modes, but persist to Azure Files mounted in the container
STORAGE_MODE=local
DB_MODE=local
LOCAL_STORAGE_DIR=/app/storage
LOCAL_DATA_DIR=/app/data

# Intake security
WORKATO_SHARED_SECRET=pon_aqui_un_secreto_largo
ENABLE_WORKATO_REMOTE_URLS=false

# Future migration targets (not yet used by current app code)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER_RAW=
AZURE_STORAGE_CONTAINER_EXPORTS=
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=facturasdb
AZURE_COSMOS_CONTAINER=documents
