NODE_ENV=production
PORT=8080

STORAGE_MODE=gcp
DB_MODE=firestore

GOOGLE_CLOUD_PROJECT=tu-proyecto
GOOGLE_CLOUD_LOCATION=us-central1

GCS_BUCKET_RAW=tu-proyecto-raw
GCS_BUCKET_EXPORTS=tu-proyecto-exports
FIRESTORE_COLLECTION=documents

USE_DOCUMENT_AI=true
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=processor-id
DOCUMENT_AI_PROCESSOR_VERSION=

WORKATO_SHARED_SECRET=pon_aqui_un_secreto_largo
COES_VALIDATION_AUTO_SYNC=true

# Firebase Authentication (login por email/contrasena).
# apiKey y authDomain NO son secretos: el frontend los recibe por
# GET /api/auth/config. La seguridad la da la verificacion del ID token en el
# backend, no ocultar estos valores.
# Los imprime setup-gcp.ps1. Con NODE_ENV=production, si falta FIREBASE_API_KEY
# el servicio no levanta (falla cerrado a proposito: una env var ausente no
# puede dejar la app abierta).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
